# 外部參考原始碼(複製進來或 clone 的第三方專案,不是本專案產出)
FPGA/zipcpu
docs/FPGA/Reference

# Claude Code 本機設定(跟機器/使用者綁定,不共用)
.claude/settings.local.json

# Vivado 專案:合成/實作過程產生的東西,可以從 .srcs 重新跑出來,不進版控
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.gen/
*.srcs/sources_1/bd/*/hw_handoff/
*.srcs/sources_1/bd/*/ip/
.Xil/
*.jou
*.log
*.pb
*.dcp
*.str
*.wdb
*.xpr.lock
webtalk*
dfx_runtime.txt

# *.sim/ 底下只有 sim_1/new/ 是手寫的 testbench 原始碼,要進版控;
# 其餘(sim_1/behav/ 之類)是跑模擬產生的執行期產物,不進版控
# FPGA/EvtDecoder/EvtDecoder.sim/sim_*/behav/
*/*/*.sim/sim_*/behav
*/*/*.sim/sim_*/synth

# FPGA/driver:kernel module 編譯產物(FPGA/driver/Makefile 的 make/make clean 可重新產生),不進版控
FPGA/driver/*.o
FPGA/driver/*.ko
FPGA/driver/*.mod
FPGA/driver/*.mod.c
FPGA/driver/.*.cmd
FPGA/driver/Module.symvers
FPGA/driver/Modules.symvers
FPGA/driver/Module.markers
FPGA/driver/modules.order
FPGA/driver/.tmp_versions/

# OS 產生的雜項檔案
Thumbs.db
.DS_Store
