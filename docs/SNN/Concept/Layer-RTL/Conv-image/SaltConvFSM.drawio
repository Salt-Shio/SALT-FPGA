<mxfile host="65bd71144e">
    <diagram name="第1頁" id="tr_yycV82_oHcQLL_Y_R">
        <mxGraphModel dx="1474" dy="772" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="light-dark(#FFFFFF,#121212)" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="state-idle" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 18px; color: light-dark(rgb(0, 0, 0), rgb(255, 42, 0));&quot;&gt;IDLE&lt;/font&gt;&lt;div&gt;等事件：EventFIFO 是空的&lt;/div&gt;&lt;div&gt;清除神經元記憶體時也停在這裡&lt;/div&gt;&lt;div&gt;(清除期間不收事件)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="100" width="280" x="560" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="state-process" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 18px; color: light-dark(rgb(0, 0, 0), rgb(255, 42, 0));&quot;&gt;PROCESS&lt;/font&gt;&lt;div&gt;讀出的資料就緒&lt;/div&gt;&lt;div&gt;M×M 個候選一起算 (s, V̂&lt;sub&gt;new&lt;/sub&gt;)&lt;/div&gt;&lt;div&gt;合法的候選寫回 V̂、t&lt;sub&gt;last&lt;/sub&gt;&lt;/div&gt;&lt;div&gt;s ∧ valid 存進 bitmask&lt;/div&gt;" vertex="1">
                    <mxGeometry height="110" width="280" x="880" y="340" as="geometry"/>
                </mxCell>
                <mxCell id="state-sending" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 18px; color: light-dark(rgb(0, 0, 0), rgb(255, 42, 0));&quot;&gt;SENDING&lt;/font&gt;&lt;div&gt;SpikeSelect 挑 (o&lt;sub&gt;y&lt;/sub&gt;, o&lt;sub&gt;x&lt;/sub&gt;) 最小的 fire 送出&lt;/div&gt;&lt;div&gt;out_ready = 1 才算送出，清掉那個 bit&lt;/div&gt;&lt;div&gt;bitmask 全 0 時 out_valid = 0&lt;/div&gt;" vertex="1">
                    <mxGeometry height="110" width="280" x="240" y="340" as="geometry"/>
                </mxCell>
                <mxCell id="edge-idle-process" edge="1" parent="1" source="state-idle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;labelBackgroundColor=default;" target="state-process" value="&lt;span style=&quot;font-size: 16px; color: light-dark(rgb(255, 0, 0), rgb(255, 90, 90));&quot;&gt;FIFO 有事件&lt;/span&gt;&lt;div&gt;同一拍：&lt;/div&gt;&lt;div&gt;・從 FIFO 拿出事件，存進事件暫存器&lt;/div&gt;&lt;div&gt;・o&lt;sub&gt;c&lt;/sub&gt; = 0，送讀位址&lt;/div&gt;&lt;div&gt;・CandidateGrid 算出的候選存起來&lt;/div&gt;">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="20" as="offset"/>
                        <Array as="points">
                            <mxPoint x="1020" y="110"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="edge-process-sending" edge="1" parent="1" source="state-process" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=default;" target="state-sending" value="&lt;span style=&quot;font-size: 16px; color: light-dark(rgb(255, 0, 0), rgb(255, 90, 90));&quot;&gt;一定走(下一拍一定是 SENDING)&lt;/span&gt;">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1020" y="540"/>
                            <mxPoint x="380" y="540"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="edge-sending-process" edge="1" parent="1" source="state-sending" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;align=left;labelBackgroundColor=default;" target="state-process" value="&lt;span style=&quot;font-size: 16px; color: light-dark(rgb(255, 0, 0), rgb(255, 90, 90));&quot;&gt;bitmask 會變空，還有下一個 o&lt;sub&gt;c&lt;/sub&gt;&lt;/span&gt;&lt;div&gt;同一拍送下一個 o&lt;sub&gt;c&lt;/sub&gt; 的讀位址，候選存起來：&lt;/div&gt;&lt;div&gt;・o&lt;sub&gt;c&lt;/sub&gt; &amp;lt; OC−1：o&lt;sub&gt;c&lt;/sub&gt; + 1&lt;/div&gt;&lt;div&gt;・o&lt;sub&gt;c&lt;/sub&gt; = OC−1 而且 FIFO 有事件：&lt;/div&gt;&lt;div&gt;&amp;nbsp; 換下一筆事件(拿出、存進事件暫存器)，o&lt;sub&gt;c&lt;/sub&gt; = 0&lt;/div&gt;">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="-170" y="-60" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="edge-sending-idle" edge="1" parent="1" source="state-sending" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=default;" target="state-idle" value="&lt;span style=&quot;font-size: 16px; color: light-dark(rgb(255, 0, 0), rgb(255, 90, 90));&quot;&gt;bitmask 會變空，o&lt;sub&gt;c&lt;/sub&gt; = OC−1，FIFO 是空的&lt;/span&gt;">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint y="40" as="offset"/>
                        <Array as="points">
                            <mxPoint x="380" y="110"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="edge-sending-stay" edge="1" parent="1" source="state-sending" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;align=left;labelBackgroundColor=default;" target="state-sending" value="&lt;span style=&quot;font-size: 16px; color: light-dark(rgb(255, 0, 0), rgb(255, 90, 90));&quot;&gt;bitmask 不會變空&lt;/span&gt;&lt;div&gt;・還剩 2 個以上&lt;/div&gt;&lt;div&gt;・或 out_ready = 0(送不出去)&lt;/div&gt;">
                    <mxGeometry relative="1" x="-0.061" y="-160" as="geometry">
                        <mxPoint as="offset"/>
                        <Array as="points">
                            <mxPoint x="180" y="373"/>
                            <mxPoint x="180" y="417"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;rounded=0;strokeColor=default;spacing=10;" value="&lt;div&gt;&lt;b&gt;怎麼看&lt;/b&gt;：每個框是一拍做的事；箭頭是這一拍結束時往哪走，箭頭上寫條件(紅字)跟同一拍順便做的事。rst_n = 0 時回到 IDLE。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;「bitmask 會變空」&lt;/b&gt;：這一拍做完，bitmask 是全 0&lt;/div&gt;&lt;div&gt;・本來就全 0(這個 o&lt;sub&gt;c&lt;/sub&gt; 沒有 fire)&lt;/div&gt;&lt;div&gt;・只剩 1 個，而且 out_ready = 1(這一拍送出去了)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;out_ready = 0(反壓)&lt;/b&gt;：不清 bit、不換 o&lt;sub&gt;c&lt;/sub&gt;、不送讀位址，事件暫存器、候選、bitmask 都不變，下一拍重試同一件事。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;拍數&lt;/b&gt;：out_ready 一直是 1 時，一個 o&lt;sub&gt;c&lt;/sub&gt; 占 PROCESS 1 拍 + SENDING max(1, k) 拍，k 是這個 o&lt;sub&gt;c&lt;/sub&gt; fire 的個數。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;規格見 Layer-RTL/Conv.md 5.7。&lt;/div&gt;" vertex="1">
                    <mxGeometry height="210" width="920" x="240" y="590" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>